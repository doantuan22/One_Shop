# Copy this file to `.env` (which is git-ignored) and fill in real values.
# Never commit real credentials.

# --- SQL Server (cloud) ---
DB_HOST=
DB_PORT=1433
DB_NAME=oneshop
DB_USERNAME=
DB_PASSWORD=

# --- JWT (at least 32 characters, e.g. `openssl rand -base64 48`) ---
JWT_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP mail (forgot-password one-time codes) ---
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=<address>, MAIL_PASSWORD=<an App Password, not the login password>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Optional ---
# SPRING_PROFILES_ACTIVE=dev
# PORT=8080
# DB_TRUST_SERVER_CERTIFICATE=false   # set true only for a local SQL Server with a self-signed certificate
# Hibernate uses ddl-auto=validate; apply SQL migrations explicitly after backup/approval.
# ONESHOP_PAYMENT_TIMEOUT_WORKER_ENABLED=false # default OFF: true starts the scan that cancels unpaid ONLINE orders after 15 minutes and restores stock
# DB_JDBC_OPTIONS=;trustStore=/etc/oneshop/rds-truststore.jks;trustStorePassword=...   # appended to the JDBC URL (AWS RDS CA)
# DB_POOL_SIZE=5
# SPRING_PROFILES_ACTIVE=prod   # REQUIRED in production: the default profile is dev
# ONESHOP_CHECKOUT_ONLINE_ENABLED=false   # default true in dev, false in the prod profile (no real gateway)
# ONESHOP_PAYMENT_MOCK_GATEWAY_ENABLED=false   # default true in dev, false in prod
# JWT_EXPIRATION_MINUTES=60
# JWT_COOKIE_SECURE=true
