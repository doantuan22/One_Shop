# Copy this file to `.env` (which is git-ignored) and fill in real values.
# Never commit real credentials.

# --- SQL Server (cloud) ---
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- JWT (at least 32 characters, e.g. `openssl rand -base64 48`) ---
JWT_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional ---
# SPRING_PROFILES_ACTIVE=dev
# PORT=8080
# DB_TRUST_SERVER_CERTIFICATE=false   # set true only for a local SQL Server with a self-signed certificate
# JPA_DDL_AUTO=none                   # prod only: none | validate | update
# JWT_EXPIRATION_MINUTES=60
# JWT_COOKIE_SECURE=true
