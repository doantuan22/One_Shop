# Copy to /etc/oneshop/oneshop.env on the server (chown root:oneshop, chmod 640) and fill in the values from your secret store.
# NEVER commit the filled-in file. Values here are placeholders only.

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# SQL Server (for example the Amazon RDS endpoint). The database must already exist: see docs/AWS_DEPLOYMENT.md
DB_HOST=<rds-endpoint>.<region>.rds.amazonaws.com
DB_PORT=1433
DB_NAME=oneshop
DB_USERNAME=<application login: NOT the RDS master user>
DB_PASSWORD=<secret>
DB_TRUST_SERVER_CERTIFICATE=false
# Trust the Amazon RDS certificate authority (see the guide for how to build the trust store)
DB_JDBC_OPTIONS=;trustStore=/etc/oneshop/rds-truststore.jks;trustStorePassword=<secret>;hostNameInCertificate=*.<id>.<region>.rds.amazonaws.com
DB_POOL_SIZE=10

# At least 32 bytes: openssl rand -base64 48
JWT_SECRET=<secret>
JWT_COOKIE_SECURE=true

CLOUDINARY_CLOUD_NAME=<name>
CLOUDINARY_API_KEY=<key>
CLOUDINARY_API_SECRET=<secret>

# Forgot-password codes by e-mail (leave MAIL_HOST empty to switch the feature off)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Closed in production by default (no real payment gateway exists). Leave unset unless this is a demo deployment.
# ONESHOP_CHECKOUT_ONLINE_ENABLED=false
# ONESHOP_PAYMENT_MOCK_GATEWAY_ENABLED=false
# ONESHOP_PAYMENT_TIMEOUT_WORKER_ENABLED=false
